---
import BrandMark from './BrandMark.astro'
import { PRODUCT_NAME } from '../config/product'
import { copy } from '../i18n/copy'

interface Props {
  titleKey?: 'finale' | 'solo.title'
  solo?: boolean
}

const { titleKey = 'finale', solo = false } = Astro.props
const t = copy.en
const year = new Date().getFullYear()
const title = titleKey === 'solo.title' ? t.solo.title : t.finale
const Title = solo ? 'h1' : 'h2'
const accentLength = PRODUCT_NAME.toUpperCase().startsWith('AI') ? 2 : 0
const brandLetters = [...PRODUCT_NAME].map((letter, index) => ({ letter: letter.toLowerCase(), accent: index < accentLength }))
---

<section class:list={['finale', { 'is-solo': solo }]} id="senal" data-finale aria-labelledby="finale-title">
  <div class="finale__top">
    {solo ? (
      <Title class="finale__title" id="finale-title">
        <span class="finale__brand">
          <span class="sr-only">{PRODUCT_NAME}. </span>
          <span class="finale__brand-line finale__brand-line--start" aria-hidden="true"></span>
          <span class="finale__brand-name" aria-hidden="true">
            {brandLetters.map(({ letter, accent }, index) => (
              <span class:list={['finale__brand-letter', { 'is-accent': accent }]} style={`--li:${index}`}>{letter}</span>
            ))}
          </span>
          <span class="finale__brand-line finale__brand-line--end" aria-hidden="true"></span>
        </span>
        <span class="finale__claim" data-i18n-html={titleKey} set:html={title} />
      </Title>
    ) : (
      <Title class="finale__title" id="finale-title" data-i18n-html={titleKey} set:html={title} />
    )}
  </div>

  <div class="finale__grid">

    <button class="seal" type="button" data-seal data-cursor-key="press" data-cursor-text={t.cursor.press} data-i18n-aria="soon" aria-label={t.soon}>
      <svg class="seal__ring" viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <path id="seal-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
        </defs>
        <text><textPath href="#seal-path" textLength="486" lengthAdjust="spacing" data-i18n="ring">{t.ring}</textPath></text>
      </svg>
      <span class="seal__core">
        <BrandMark class="seal__mark" />
      </span>
      <span class="seal__soon" data-seal-soon aria-live="polite"></span>
    </button>
  </div>

  <footer class="footer">
    <span>© {year} {PRODUCT_NAME}</span>
    <a class="footer__mail" href="mailto:aravenagonzalo@aisland.si" data-cursor-key="mail" data-cursor-text={t.cursor.mail}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-11Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <span>aravenagonzalo@aisland.si</span>
    </a>
    <span data-i18n="progress">{t.progress}</span>
  </footer>
</section>
