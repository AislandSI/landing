---
import Layout from '../layouts/Layout.astro'
import Preloader from '../components/Preloader.astro'
import Cursor from '../components/Cursor.astro'
import Hero from '../components/Hero.astro'
import Marquee from '../components/Marquee.astro'
import Manifesto from '../components/Manifesto.astro'
import EyesWall from '../components/EyesWall.astro'
import Finale from '../components/Finale.astro'
---

<Layout>
  <Preloader />
  <div class="cosmos" aria-hidden="true">
    <div class="cosmos__fallback"></div>
    <canvas class="cosmos__canvas" data-cosmos></canvas>
    <div class="cosmos__vignette"></div>
  </div>
  <svg class="grain" aria-hidden="true">
    <filter id="grain-filter">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-filter)" />
  </svg>
  <Cursor />
  <main>
    <Hero />
    <Marquee />
    <Manifesto />
    <EyesWall />
    <Finale />
  </main>
</Layout>
