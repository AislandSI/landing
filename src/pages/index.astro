---
import Layout from '../layouts/Layout.astro'
import Cursor from '../components/Cursor.astro'
import Hud from '../components/Hud.astro'
import Finale from '../components/Finale.astro'
import BrandMark from '../components/BrandMark.astro'
import { PRODUCT_NAME } from '../config/product'
import { copy } from '../i18n/copy'
---

<Layout title={`${PRODUCT_NAME} — ${copy.en.solo.metaTitle}`} titleKey="solo.metaTitle" solo>
  <div class="cosmos" aria-hidden="true">
    <div class="cosmos__fallback"></div>
    <canvas class="cosmos__canvas" data-cosmos></canvas>
    <div class="cosmos__vignette"></div>
  </div>
  <svg class="grain" aria-hidden="true">
    <filter id="grain-filter">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-filter)" />
  </svg>
  <Cursor />
  <main class="solo">
    <Hud href="/" />
    <div class="solo__mark" aria-hidden="true"><BrandMark /></div>
    <canvas class="solo__orbit" data-orbit aria-hidden="true"></canvas>
    <Finale solo titleKey="solo.title" />
  </main>
  <script>
    import { startSolo } from '../scripts/solo'
    startSolo()
  </script>
</Layout>
